# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key

# Razorpay API Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret

# Razorpay MCP Basic Auth Token: base64(KEY_ID:KEY_SECRET)
RAZORPAY_MCP_TOKEN=base64_encoded_key_secret_token

# Toggle Data Source: true = use synthetic data fallback, false = use live MCP endpoint
USE_SYNTHETIC=true
